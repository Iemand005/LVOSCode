{
  "name": "lvos",
  "displayName": "LVOSCode",
  "publisher": "lvos",
  "description": "Lightweight Virtual Operating System",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iemand005/LVOSCode.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onCommand:lvos.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lvos.open",
        "title": "Open LVOS"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "1.14.0",
    "mocha": "3.5.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6"
  }
}
